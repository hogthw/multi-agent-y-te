# Khóa API Google Gemini (lấy miễn phí tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Giới hạn request/phút an toàn cho Gemini Free Tier (tăng lên 60 nếu dùng gói trả phí)
GEMINI_MAX_RPM=12

